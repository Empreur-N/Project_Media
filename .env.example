# ==============================================================================
# LIFE CHANNEL - FICHIER DE CONFIGURATION D'ENVIRONNEMENT (EXEMPLE)
# Copiez ce fichier en '.env' à la racine pour personnaliser vos variables.
# ==============================================================================

# --- GESTION DES CONFLITS DE PORTS (DÉVELOPPEMENT SOUS WINDOWS / LINUX) ---
# Si vous avez déjà PostgreSQL natif d'installé sur Windows (port 5432 utilisé) :
# Définissez POSTGRES_PORT=5433 et DB_PORT=5433 pour éviter tout conflit !
POSTGRES_PORT=5432
MONGO_PORT=27017
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
REDIS_PORT=6379

# --- BASES DE DONNÉES RELATIONNELLES (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Noms de bases de données par service :
# user_service    -> user_db
# content_service -> content_db
# comment_service -> comment_db
# live_service    -> live_db
# ad_service      -> ad_db

# --- BASES DE DONNÉES DOCUMENTAIRES (MongoDB) ---
MONGO_HOST=localhost
# podcast_service   -> podcast_db
# media_service     -> media_db
# search_service    -> search_db
# analytics_service -> analytics_db

# --- MESSAGE BROKER (RabbitMQ) ---
RABBITMQ_HOST=localhost
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# --- CACHE & STREAMING (Redis) ---
REDIS_HOST=localhost

# --- SERVICE DISCOVERY (Spring Cloud Netflix Eureka) ---
EUREKA_URI=http://localhost:8761/eureka/

# --- SÉCURITÉ & AUTHENTIFICATION (JWT) ---
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION=86400000

# --- PORTS DES MICROSERVICES (Personnalisables si conflit d'application) ---
PORT_API_GATEWAY=8080
PORT_USER_SERVICE=8081
PORT_CONTENT_SERVICE=8082
PORT_MEDIA_SERVICE=8083
PORT_COMMENT_SERVICE=8084
PORT_SEARCH_SERVICE=8085
PORT_PODCAST_SERVICE=8087
PORT_LIVE_SERVICE=8088
PORT_NOTIFICATION_SERVICE=8089
PORT_ANALYTICS_SERVICE=8090
PORT_AD_SERVICE=8091
PORT_DISCOVERY=8761
